# Copy to .env for local use. These are LOCAL DEVELOPMENT placeholders, not secrets - choose your own values.
POSTGRES_DB=campus
POSTGRES_USER=campus
POSTGRES_PASSWORD=change_me_local_only

# Backend (read by Spring; defaults match docker-compose when unset)
DB_URL=jdbc:postgresql://localhost:5432/campus
DB_USER=campus
DB_PASSWORD=change_me_local_only
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
BLOOM_EXPECTED_INSERTIONS=10000
BLOOM_FPP=0.01

# Frontend (see frontend/.env.example)
